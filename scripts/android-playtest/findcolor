#!/bin/zsh
# findcolor <r> <g> <b> [tolerance] : take a screenshot and print the centre (half-size coordinates) and size of each
# blob near that colour, with how old the capture is in seconds. For moving targets (bubbles, a character) that a
# screenshot read by eye is too slow for. FINDCOLOR_SKIP_TOP skips that many half-size rows at the top (a header).
D=${PLAYTEST_DIR:-/tmp/playtest}; mkdir -p $D
t0=$(python3 -I -c 'import time;print(time.time())')
adb exec-out screencap -p > $D/fc.png
w=$(sips -g pixelWidth $D/fc.png | awk '/pixelWidth/{print $2}'); h=$(sips -g pixelHeight $D/fc.png | awk '/pixelHeight/{print $2}')
W=$(( w / 8 )); H=$(( h / 8 ))
ffmpeg -y -loglevel error -i $D/fc.png -vf scale=$W:$H -f rawvideo -pix_fmt rgb24 $D/fc.raw
python3 -I - $D/fc.raw $W $H $(( ${FINDCOLOR_SKIP_TOP:-0} / 4 )) $t0 "$@" <<'PY'
import sys,time
raw,W,H,top=sys.argv[1],int(sys.argv[2]),int(sys.argv[3]),int(sys.argv[4]); t0=float(sys.argv[5])
r,g,b=map(int,sys.argv[6:9]); tol=int(sys.argv[9]) if len(sys.argv)>9 else 40
d=open(raw,'rb').read()
seen=set(); out=[]
def ok(x,y):
    i=(y*W+x)*3; return abs(d[i]-r)<tol and abs(d[i+1]-g)<tol and abs(d[i+2]-b)<tol
for y in range(top,H):
    for x in range(W):
        if (x,y) in seen or not ok(x,y): continue
        st=[(x,y)]; seen.add((x,y)); pts=[]
        while st:
            a,c=st.pop(); pts.append((a,c))
            for dx,dy in((1,0),(-1,0),(0,1),(0,-1)):
                n=(a+dx,c+dy)
                if 0<=n[0]<W and top<=n[1]<H and n not in seen and ok(*n): seen.add(n); st.append(n)
        if len(pts)>30: out.append((sum(p[0] for p in pts)*4//len(pts), sum(p[1] for p in pts)*4//len(pts), len(pts)))
print(out, 'age', round(time.time()-t0,2))
PY
