#!/bin/zsh
# act <name> <seconds> <command...> : do one thing (a tap, swipe or trace) while recording sound, then ui and shot.
# Prints HEARD: with the transcript of what the app said in answer.
export PATH=${0:A:h}:$PATH
n=$1; secs=$2; shift 2
( sleep 1.7; eval "$@" ) &
echo "HEARD:$(hear $n-a $secs 0)"
ui
shot $n
