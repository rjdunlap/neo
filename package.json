{
  "name": "neo",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:lan": "vite --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "icons": "pwa-assets-generator",
    "build-and-preview": "npm run build && vite preview --port 4173 --strictPort",
    "test:browser": "node scripts/browser-check.mjs",
    "test:offline": "node scripts/offline-check.mjs",
    "new-game": "node scripts/new-game.mjs",
    "game-docs": "GAME_DOCS=write vitest run src/content/game-docs.test.ts",
    "format": "prettier --write \"src/**/*.{ts,css}\" \"scripts/**/*.{mjs,ts}\" \"*.{ts,mjs,json,html}\" \".github/workflows/*.{yml,yaml}\" .prettierrc.json",
    "format:check": "prettier --check \"src/**/*.{ts,css}\" \"scripts/**/*.{mjs,ts}\" \"*.{ts,mjs,json,html}\" \".github/workflows/*.{yml,yaml}\" .prettierrc.json",
    "lint": "eslint src/",
    "lint:prune": "eslint src/ --prune-suppressions"
  },
  "dependencies": {
    "@fontsource/fredoka": "^5.3.0",
    "idb-keyval": "^6.3.0",
    "pixi.js": "^8.22.0"
  },
  "devDependencies": {
    "@typescript/native": "npm:typescript@7.0.2",
    "@vite-pwa/assets-generator": "^2.0.0",
    "eslint": "^10.14.0",
    "playwright": "^1.62.1",
    "prettier": "^3.9.10",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.2",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.3"
  }
}
